+/* PSBC: GFX10.1 prefers splitting weak (GLSL) FMAs into MUL+ADD so that they
+ * can become legacy MADs. In large compute reductions CSE then shares the split
+ * products between accumulators, and those long-lived products spill heavily:
+ * FSR4's network passes lose most of their time to scratch traffic. Compute
+ * kernels keep the fused form instead, which runs at full rate on GFX10.1. */
+static bool
+psbc_fuse_weak_ffma32(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   (void)data;
+   if (alu->op != nir_op_ffma_weak || alu->def.bit_size != 32)
+      return false;
+   alu->op = nir_op_ffma;
+   return true;
+}
+
 nir_shader *
 radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct radv_shader_stage *stage,
                          const struct radv_spirv_to_nir_options *options, bool is_internal)
@@ -553,6 +569,10 @@
       assert(nir->info.stage == stage->stage);
       nir_validate_shader(nir, "after spirv_to_nir");
 
